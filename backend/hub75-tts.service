# Systemd service file for HUB75 TTS Server
# Copy to: /etc/systemd/system/hub75-tts.service
#
# Installation:
#   sudo cp hub75-tts.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable hub75-tts
#   sudo systemctl start hub75-tts
#
# Check status: sudo systemctl status hub75-tts
# View logs: sudo journalctl -u hub75-tts -f

[Unit]
Description=HUB75 TTS Announcement Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=threadrepair
WorkingDirectory=/home/threadrepair/hub75-backend
ExecStart=/home/threadrepair/hub75-backend/venv/bin/python /home/threadrepair/hub75-backend/tts_server.py
Restart=always
RestartSec=10

# Performance optimizations for Pi 3B+
Nice=5
CPUQuota=50%
MemoryLimit=256M

[Install]
WantedBy=multi-user.target
