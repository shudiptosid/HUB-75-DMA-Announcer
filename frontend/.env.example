# MQTT Broker Configuration
# Copy this file to .env.local and fill in your real values
# .env.local is gitignored — your credentials will NOT go to GitHub

# HiveMQ Cloud WebSocket URL (wss://YOUR_CLUSTER.s1.eu.hivemq.cloud:8884/mqtt)
VITE_MQTT_BROKER=wss://YOUR_CLUSTER.s1.eu.hivemq.cloud:8884/mqtt

# HiveMQ Cloud credentials (from Access Management)
VITE_MQTT_USER=your_username
VITE_MQTT_PASS=your_password

# Weather location (find coordinates at https://www.latlong.net/)
VITE_DEFAULT_LATITUDE=31.375
VITE_DEFAULT_LONGITUDE=75.625
VITE_DEFAULT_CITY=Jalandhar
